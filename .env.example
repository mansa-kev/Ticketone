# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# App Hosting Details
APP_URL=https://pay.owlenix.com
NEXT_PUBLIC_APP_URL=https://pay.owlenix.com

# Supabase Keys (Dual-Engine Mode):
# Define these to instantly switch the back office and gateway from local storage to live Postgres tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOWPayments Configuration
PAYMENT_PROVIDER=nowpayments
PAYMENT_MODE=card_fiat_onramp
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PUBLIC_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAYMENTS_SANDBOX_MODE=false
NOWPAYMENTS_WEBHOOK_URL=https://pay.owlenix.com/api/webhooks/nowpayments

# Default Settlement Details
DEFAULT_SETTLEMENT_ASSET=USDT
DEFAULT_SETTLEMENT_NETWORK=TRC20
DEFAULT_SETTLEMENT_ADDRESS=
DEFAULT_SETTLEMENT_ADDRESS_LABEL=Binance USDT TRC20 Wallet

# Return URL variables
PAYMENT_SUCCESS_URL=https://pay.owlenix.com/payment/success
PAYMENT_PENDING_URL=https://pay.owlenix.com/payment/pending
PAYMENT_FAILED_URL=https://pay.owlenix.com/payment/failed
PAYMENT_CANCEL_URL=https://pay.owlenix.com/payment/cancelled
